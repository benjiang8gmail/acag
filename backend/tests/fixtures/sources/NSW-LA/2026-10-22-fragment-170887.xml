        <topic>
          <topicinfo>
            <text>Knife Crime</text>
          </topicinfo>
          <question>
            <talk.start>
              <talker>
                <talk.time></talk.time>
                <id>2288</id>
                <name>Ms KELLIE SLOANE</name>
                <electorate>Vaucluse</electorate>
                <portfolios />
                <question.number />
                <question.date />
              </talker>
            </talk.start>
          </question>
          <answer>
            <talk.start>
              <talker>
                <talk.time></talk.time>
                <id>128</id>
                <name>Ms YASMIN CATLEY</name>
                <electorate>Swansea</electorate>
                <portfolios>
                  <portfolio>Minister for Police and Counter-terrorism</portfolio>
                  <portfolio>Minister for the Hunter</portfolio>
